{
  "name": "msw-answer-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MSW 크리에이터 문의에 공식 문서 근거로 팩트체크된 답변을 생성하는 웹앱",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/scan-kb.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "crawl:docs": "node scripts/crawl-docs.mjs --lang ko",
    "build:kb": "node scripts/build-kb.mjs",
    "build:qa": "node scripts/build-qa.mjs",
    "crawl:policies": "node scripts/crawl-policies.mjs",
    "kb": "npm run crawl:docs && npm run crawl:policies && npm run build:kb && npm run build:qa"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
